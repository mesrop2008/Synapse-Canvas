# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false

# --- Database --------------------------------------------------------------
# Must use the asyncpg driver -- the app validates this on startup.
#
# Pointing at a locally installed PostgreSQL (default port 5432):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synapse_canvas
#
# Pointing at the bundled docker-compose service instead (port 5433, chosen so
# it does not collide with a native PostgreSQL already on 5432):
# DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse_canvas

# Separate database for pytest. The suite drops and recreates every table in
# it on each run, so it must NOT be your development database.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/synapse_canvas_test

# --- Auth ------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- HTTP ------------------------------------------------------------------
# Comma-separated. Empty disables the CORS middleware entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- docker-compose only ---------------------------------------------------
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse_canvas
POSTGRES_PORT=5433
