# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false

# --- Database --------------------------------------------------------------
# Must use the asyncpg driver -- settings validation rejects anything else.
#
# These are the HOST-side URLs, used by `alembic` and `pytest` when you run
# them on your machine. They need the dev overlay (docker-compose.dev.yml),
# which publishes the compose Postgres on localhost:POSTGRES_PORT (5433).
#
# The `api` container does NOT use these: inside the compose network the
# database is `postgres:5432`, and docker-compose.yml sets that directly.
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse_canvas

# Separate database for pytest. The suite creates it if missing, then drops
# and recreates every table in it -- never point this at real data.
TEST_DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse_canvas_test

# --- Redis -----------------------------------------------------------------
# Presence, WebSocket handshake tickets and the pub/sub channel that lets one
# Uvicorn worker's connections hear about another's writes. Holds nothing
# durable, so it can be flushed at any time.
#
# Host-side URL; inside the compose network the API uses redis:6379, set
# directly in docker-compose.yml. The host port avoids a native Redis on 6379.
REDIS_URL=redis://localhost:6381/0

# Redis for pytest. Leave it unset and the suite runs against an in-process
# fake instead -- see tests/conftest.py.
TEST_REDIS_URL=redis://localhost:6381/1

# --- Real-time collaboration -----------------------------------------------
# Handshake ticket lifetime. The browser redeems it immediately; this only has
# to cover opening the socket.
WS_TICKET_TTL_SECONDS=30
# The client pings on the interval; the server closes a socket that has been
# silent for the timeout.
WS_HEARTBEAT_INTERVAL_SECONDS=10
WS_IDLE_TIMEOUT_SECONDS=45
# An edit carries the document it produced, so this scales with document size.
WS_MAX_MESSAGE_BYTES=262144
# Edits accepted per connection per window; over it, the socket is closed.
WS_EDIT_RATE_LIMIT=60
WS_EDIT_RATE_LIMIT_WINDOW_SECONDS=10
# How long a presence entry survives its last heartbeat.
PRESENCE_TTL_SECONDS=30

# --- AI assistant ----------------------------------------------------------
# fake: scripted replies, no key or network; local/test only.
# gemini: needs GEMINI_API_KEY. Without one the app still starts and AI
#   requests fail with ai.invalid_key.
LLM_PROVIDER=fake
# https://aistudio.google.com/apikey -- never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 turns thinking off on Flash (cheaper); -1 leaves it to the model.
GEMINI_THINKING_BUDGET=0
LLM_TIMEOUT_SECONDS=60
FAKE_LLM_DELAY_SECONDS=0.04

# Per workspace. Prompt + completion tokens, reset at 00:00 UTC. Over either
# limit, creating a query returns 429.
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_CONCURRENT_QUERIES=2
# Document text sent per query (~3 characters a token); cut from the middle.
AI_CONTEXT_TOKEN_LIMIT=6000
AI_MAX_OUTPUT_TOKENS=1024
# A generation with no reader is cancelled after this, leaving time to resume.
AI_RECONNECT_GRACE_SECONDS=10
AI_STREAM_KEEPALIVE_SECONDS=15
AI_BUFFER_TTL_SECONDS=600
AI_QUERY_TIMEOUT_SECONDS=300

# --- Auth ------------------------------------------------------------------
# Leave blank and the container generates a key on first run, persisting it to
# a Docker volume so it survives restarts. Deliberately not shipped with a
# placeholder value: a committed default would become the real signing key for
# everyone who copied this file, and anyone reading the repo could forge tokens.
#
# Set your own to pin it (minimum 32 characters) -- required outside
# local/test, where the container refuses to start without one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Rotating the signing key: move the current value here, put a new one in
# JWT_SECRET_KEY, and deploy. Tokens signed by a key listed here keep working,
# so nobody is logged out. Remove a key once every token it signed has expired
# -- at most REFRESH_TOKEN_EXPIRE_DAYS later. Comma-separated.
PREVIOUS_JWT_SECRET_KEYS=

# Pinned into every token and checked on decode, so a token minted by another
# deployment is rejected even if it happens to share a secret.
JWT_ISSUER=synapse-canvas
JWT_AUDIENCE=synapse-canvas-api

# Requests declaring a larger body are refused before it is read (1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Email verification ----------------------------------------------------
# A new account is inactive until it redeems the six-digit code emailed to it;
# until then it cannot log in or be invited to a workspace.
#
# A code has a million possible values, so these limits are what make it safe:
# it lives 5 minutes, dies after 5 wrong guesses, can be re-sent once a minute
# and 5 times an hour, and each address gets 20 wrong guesses a day across all
# of its codes. Set a send or failure limit to 0 to disable it.
EMAIL_VERIFICATION_CODE_TTL_SECONDS=300
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_SEND_LIMIT=5
EMAIL_VERIFICATION_SEND_LIMIT_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_FAILURE_LIMIT=20
EMAIL_VERIFICATION_FAILURE_LIMIT_WINDOW_SECONDS=86400

# Registration refuses a domain DNS says cannot receive mail (gmail.con). If
# the lookup fails or times out, the address is allowed. Some networks' DNS
# (certain VPNs, Docker Desktop behind them) never answers "no such domain";
# point the lookup at a public resolver there, e.g. 1.1.1.1,8.8.8.8.
EMAIL_CHECK_DELIVERABILITY=true
EMAIL_DNS_SERVERS=

# --- Outgoing mail -----------------------------------------------------------
# console: messages, codes included, are written to the API log -- look for
#   [email:console]. Only allowed with ENVIRONMENT=local or test.
# smtp: delivered through the SMTP server below. Required everywhere else.
EMAIL_BACKEND=console

# Any SMTP server works. Common ones:
#   Gmail     smtp.gmail.com  587 starttls  (an App Password, not your own:
#             Google Account > Security > 2-Step Verification > App passwords)
#   Yandex    smtp.yandex.ru  465 tls       (an app password, with IMAP/SMTP
#             access switched on in Yandex Mail settings)
#   Mail.ru   smtp.mail.ru    465 tls       (a password for external apps)
# The From address must be the mailbox you authenticate as (or one it may send
# as), or the provider rejects the message or marks it as spam.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually 587), tls (usually 465), or none -- none only for a relay
# on the same host, and never with a username: it would send the password in
# the clear, so settings refuse that combination.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Synapse Canvas

# --- Abuse resistance ------------------------------------------------------
# Throttling, not account lockout: a lockout keyed on an account lets anyone
# who knows an address lock its owner out. Set any limit to 0 to disable it.
# Login limits apply per client IP and, separately, per targeted account.
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_ACCOUNT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_PER_IP=5
REGISTER_RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_PER_IP=30
REFRESH_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300
VERIFY_EMAIL_RATE_LIMIT_PER_IP=30
VERIFY_EMAIL_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300

# Only enable behind a proxy YOU control that overwrites X-Forwarded-For.
# Otherwise a client can mint a fresh rate-limit identity per request.
#
# The bundled web container is such a proxy -- its nginx sets the header to
# $remote_addr rather than appending. It is still left off here because compose
# also publishes the API directly on API_PORT, and a client reaching that port
# could then forge the header. Turn it on once the API is only reachable through
# the proxy; until then per-IP throttling keys on nginx for proxied requests.
TRUST_PROXY_HEADERS=false

# --- HTTP ------------------------------------------------------------------
# Comma-separated. Empty disables the CORS middleware entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- docker-compose --------------------------------------------------------
# By default only WEB_PORT is published. The API, Postgres and Redis ports
# below apply only with the dev overlay, which host-side tests, migrations and
# `npm run dev` need. Uncomment both lines to use it on every `docker compose`
# command (the separator line keeps the same value working on Windows):
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse_canvas
# Host port for Postgres (dev overlay only). 5433 avoids colliding with a
# natively installed server already using 5432.
POSTGRES_PORT=5433
# Host port for Redis (dev overlay only). Not 6379: a natively installed
# server usually has it.
REDIS_PORT=6381
# Both images are pulled through mirror.gcr.io, Google's pull-through cache of
# Docker Hub. It serves the same official images, and registry-1.docker.io is
# unreachable from some networks (TLS-intercepting proxies, antivirus HTTPS
# scanning), where a direct pull fails on the Dockerfile's first line.
#
# To go direct instead:
#   PYTHON_IMAGE=python:3.13-slim
#   POSTGRES_IMAGE=postgres:15-alpine
PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim
POSTGRES_IMAGE=mirror.gcr.io/library/postgres:15-alpine
REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine

# Host port for the API container (dev overlay only), for /docs and direct
# calls. The browser does not need it -- the web container proxies /api on its
# own origin.
API_PORT=8000

# --- web client ------------------------------------------------------------
# Where you open the app -- the one port published by default. Change it if
# something else already holds 5173 (the host Vite dev server uses it too).
WEB_PORT=5173

# Baked into the bundle at build time -- Vite inlines VITE_* during `npm run
# build`, so this is a build argument, not a runtime setting. The default is a
# same-origin path proxied to the API by the container's nginx, which is why the
# image is not tied to a host or port. Change it and rebuild:
#   docker compose up -d --build web
VITE_API_BASE_URL=/api

# Both pulled through the same mirror as the other images, for the same reason.
NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
NGINX_IMAGE=mirror.gcr.io/library/nginx:1.27-alpine
