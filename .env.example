# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false

# --- Database --------------------------------------------------------------
# Must use the asyncpg driver -- settings validation rejects anything else.
#
# These are the HOST-side URLs, used by `alembic` and `pytest` when you run
# them on your machine. The compose Postgres is published on localhost:5433.
#
# The `api` container does NOT use these: inside the compose network the
# database is `postgres:5432`, and docker-compose.yml sets that directly.
DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse_canvas

# Separate database for pytest. The suite creates it if missing, then drops
# and recreates every table in it -- never point this at real data.
TEST_DATABASE_URL=postgresql+asyncpg://synapse:synapse@localhost:5433/synapse_canvas_test

# --- Auth ------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Rotating the signing key: move the current value here, put a new one in
# JWT_SECRET_KEY, and deploy. Tokens signed by a key listed here keep working,
# so nobody is logged out. Remove a key once every token it signed has expired
# -- at most REFRESH_TOKEN_EXPIRE_DAYS later. Comma-separated.
PREVIOUS_JWT_SECRET_KEYS=

# Pinned into every token and checked on decode, so a token minted by another
# deployment is rejected even if it happens to share a secret.
JWT_ISSUER=synapse-canvas
JWT_AUDIENCE=synapse-canvas-api

# Requests declaring a larger body are refused before it is read (1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Email verification ----------------------------------------------------
# A new account must confirm its address before it can log in or be invited to
# a workspace. Part 1 ships a console "sender" that logs the link instead of
# delivering it; swap in a real provider in app/services/email_service.py.
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# Where the emailed link points -- the frontend route that reads the token and
# POSTs it to /auth/verify-email.
EMAIL_VERIFICATION_LINK_BASE=http://localhost:3000/verify-email

# --- Abuse resistance ------------------------------------------------------
# Throttling, not account lockout: a lockout keyed on an account lets anyone
# who knows an address lock its owner out. Set any limit to 0 to disable it.
# Login limits apply per client IP and, separately, per targeted account.
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
LOGIN_RATE_LIMIT_PER_ACCOUNT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_PER_IP=5
REGISTER_RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_PER_IP=30
REFRESH_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300

# Only enable behind a proxy YOU control that overwrites X-Forwarded-For.
# Otherwise a client can mint a fresh rate-limit identity per request.
TRUST_PROXY_HEADERS=false

# --- HTTP ------------------------------------------------------------------
# Comma-separated. Empty disables the CORS middleware entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- docker-compose --------------------------------------------------------
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse
POSTGRES_DB=synapse_canvas
# Host port for Postgres. 5433 avoids colliding with a natively installed
# server already using 5432.
POSTGRES_PORT=5433
# Base image for the API build. Override if your network cannot reach Docker
# Hub, e.g. PYTHON_IMAGE=ghcr.io/astral-sh/uv:python3.13-bookworm-slim
PYTHON_IMAGE=python:3.13-slim

# Server major version. Bump once your registry access allows pulling it.
POSTGRES_IMAGE_TAG=15-alpine
# Host port for the API container.
API_PORT=8000
